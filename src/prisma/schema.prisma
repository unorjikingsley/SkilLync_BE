// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  role           Role
  email          String   @unique
  password       String
  firstName      String
  lastName       String
  bio            String?
  profileImage   String?
  skills         Skill[]  @relation("UserSkills")
  gigs           Gig[]
  proposals      Proposal[]
  projects       Project[] @relation("ClientProjects")
  freelancerContracts Contract[] @relation("ContractFreelancer")
  clientContracts     Contract[] @relation("ContractClient")
  reviewsGiven    Review[] @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")
  messages         Message[] @relation("UserMessages")
  receivedMessages Message[] @relation("UserReceivedMessages")
  createdAt        DateTime @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?
}

model Skill {
  id      String   @id @default(uuid())
  name    String   @unique
  users   User[]   @relation("UserSkills")
}

model Gig {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Float
  category    String
  freelancer  User     @relation(fields: [freelancerId], references: [id])
  freelancerId String
  createdAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([freelancerId])  //Added @@index for frequently queried fields.
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String
  budget      Float
  status      ProjectStatus @default(OPEN)
  client      User     @relation("ClientProjects", fields: [clientId], references: [id])
  clientId    String
  proposals   Proposal[]
  contracts   Contract[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  @@index([clientId])  //Added @@index for frequently queried fields.
}

model Proposal {
  id           String   @id @default(uuid())
  bidAmount    Float
  coverLetter  String
  freelancer   User     @relation(fields: [freelancerId], references: [id])
  freelancerId String
  project      Project  @relation(fields: [projectId], references: [id])
  projectId    String
  status       ProposalStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt    DateTime?

  @@index([freelancerId, projectId])  //Added @@index for frequently queried fields.
}

model Contract {
  id            String   @id @default(uuid())
  project       Project  @relation(fields: [projectId], references: [id])
  projectId     String
  freelancer    User     @relation("ContractFreelancer", fields: [freelancerId], references: [id])
  freelancerId  String
  client        User     @relation("ContractClient", fields: [clientId], references: [id])
  clientId      String
  status        ContractStatus @default(ACTIVE)
  escrowAmount  Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  @@index([freelancerId, clientId, projectId])  //optimize queries involving any combination of related users and project.
}

model Message {
  id          String   @id @default(uuid())
  sender      User     @relation("UserMessages", fields: [senderId], references: [id])
  senderId    String
  receiver    User     @relation("UserReceivedMessages", fields: [receiverId], references: [id])
  receiverId  String
  content     String
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderId, receiverId])  //Added @@index for frequently queried fields.
}

model Review {
  id        String   @id @default(uuid())
  reviewer  User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewerId String
  reviewee  User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  revieweeId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([reviewerId, revieweeId])  //Added @@index for frequently queried fields.
}

enum Role {
  CLIENT
  FREELANCER
  ADMIN
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  TERMINATED
}

// Key Relationships

// User ↔ Skill → Many-to-Many (User.skills & Skill.users)
// User ↔ Gig → One-to-Many (User.gigs as freelancer)
// User ↔ Project → One-to-Many (User.projects as client)
// Project ↔ Proposal → One-to-Many
// User ↔ Proposal → One-to-Many (freelancer side)
// Project ↔ Contract → One-to-Many
// User ↔ Contract → One-to-Many (freelancerContracts & clientContracts)
// User ↔ Message → Two One-to-Many relations (sender, receiver)
// User ↔ Review → Two One-to-Many relations (reviewsGiven, reviewsReceived)
