    "@prisma/client": "^6.17.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "datauri": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "prisma": "^6.17.1",
    "redis": "^5.8.3",
    "socket.io": "^4.8.1",
    "stripe": "^19.1.0",
    "zod": "^4.1.12"
  },
