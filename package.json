{
  "name": "skillync_be",
  "version": "1.0.0",
  "description": "SkilLync is a digital marketplace that bridges the gap between skilled professionals and businesses seeking top talent. We empower freelancers, creators, and experts to showcase their skills, connect with employers, and build sustainable careers, all in one dynamic platform.",
  "main": "dist/server.ts",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "prisma:generate": "prisma generate --schema ./src/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ./src/prisma/schema.prisma"
  },
